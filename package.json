{
  "name": "polymarket-low-price-maker-bot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@polymarket/client": "0.2.0",
    "better-sqlite3": "13.0.2",
    "fastify": "5.11.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
