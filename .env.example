HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/paper.db
# Docker端口默认只绑定服务器本机；仅在云防火墙已限制来源时改为0.0.0.0。
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_PORT=3000
INITIAL_CAPITAL_USD=100
TOTAL_BUDGET_USD=100
ORDER_BUDGET_USD=1
MAX_MARKET_DURATION_DAYS=30
MAX_MARKET_PROGRESS_PERCENT=20
STOP_BUY_PROGRESS_PERCENT=100
MIN_BUY_PRICE=0.01
MAX_BUY_PRICE=0.03
SCAN_INTERVAL_MS=15000
MARKET_STREAM_RECONNECT_MS=2000
PAPER_SCHEDULER_INTERVAL_MS=1000
PAPER_SETTLEMENT_INTERVAL_MS=30000
PAPER_VALIDATION_INTERVAL_MS=60000
